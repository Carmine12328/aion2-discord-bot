# Incolla qui il tuo Webhook URL creato sul canale Discord:
# (Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Fuso orario per il server europeo (UTC+2)
TIMEZONE=Europe/Rome

# Minuti di preavviso per la notifica (default 10)
ADVANCE_MINUTES=10

# Menzioni opzionali (es. @everyone, @here, oppure ID del ruolo <@&123456789>, o vuoto)
DISCORD_MENTION=

# Intervallo di controllo in secondi
POLL_INTERVAL_SECONDS=30
